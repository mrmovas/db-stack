# Database connection settings
DATABASE_HOST=localhost      # Not used in docker-compose, but can be used for local development
DATABASE_PORT=5432           # Not used in docker-compose, but can be used for local development
DATABASE_USER=postgres       # Used in docker-compose for the POSTGRES_USER environment variable
DATABASE_PASSWORD=postgres   # Used in docker-compose for the POSTGRES_PASSWORD environment variable
DATABASE_DB=appdb            # Used in docker-compose for the POSTGRES_DB environment variable

SCHEDULED_LOCALE=el-GR             # Locale for scheduled backup timestamps (default: "en-US")
SCHEDULED_TIMEZONE=Europe/Athens   # IANA timezone for scheduled backup timestamps (default: "UTC")
SCHEDULED_TIME=0 0 * * *           # Cron expression for scheduled backups (default: every day at 12 AM)
SCHEDULED_BACKUP_RETENTION_DAYS=7  # Number of days to retain scheduled backups (default: 7)
MAX_ATTEMPTS_ON_BACKUP_FAILURE=3   # Number of retries if a scheduled backup fails (default: 3)
RETRY_DELAY_SECONDS=3600           # Seconds to wait between retry attempts (default: 1 hour)
