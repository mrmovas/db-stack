# Database connection settings
# Hosted mode (--profile hosted): set DATABASE_HOST=postgres (the Docker service name)
# External mode (no profile):     set DATABASE_HOST to your external database hostname
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DB=appdb

SCHEDULED_LOCALE=el-GR             # Locale for scheduled backup timestamps (default: "en-US")
SCHEDULED_TIMEZONE=Europe/Athens   # IANA timezone for scheduled backup timestamps (default: "UTC")
SCHEDULED_TIME=0 0 * * *           # Cron expression for scheduled backups (default: every day at 12 AM)
SCHEDULED_BACKUP_RETENTION_DAYS=7  # Number of days to retain scheduled backups (default: 7)
